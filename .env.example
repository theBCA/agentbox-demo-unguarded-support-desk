# Copy to `.env` and paste a real OpenAI key.
#
# That instruction IS the demonstration. This app talks to the AI company
# directly, so it needs a live provider credential sitting in its own
# environment -- readable by its own code, by every package it imports, and
# by any subprocess an agent talks it into spawning.
#
# The AgentBox starter next door needs nothing here at all. It is handed a
# SecureProxy base URL and a per-application virtual key that is scoped to
# that one app, revocable on its own, and worth nothing at the vendor.
OPENAI_API_KEY=

# Optional.
OPENAI_MODEL=gpt-5.2
